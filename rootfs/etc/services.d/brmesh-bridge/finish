#!/usr/bin/env bashio
# ==============================================================================
# Stop the add-on when the service exits unexpectedly (s6-overlay v3)
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
    bashio::log.warning "BRMesh Bridge exited with code ${1}, stopping the add-on"
    exec /run/s6/basedir/bin/halt
fi
